# ============================================
# BEON MAILER - KONFIGURASI ENVIRONMENT
# ============================================
# Salin file ini ke .env dan isi dengan nilai yang sesuai
# cp .env.example .env

# ============================================
# SMTP CONFIGURATION (WAJIB)
# ============================================
SMTP_MODE=single
SMTP_LIST_PATH=smtp/servers.csv
SMTP_SELECTION=round_robin
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-password-or-app-password
SMTP_SECURE=false
# SMTP_SECURE: true untuk port 465 (SSL), false untuk port 587 (TLS/STARTTLS)

# TLS dan batas per server; CSV dapat override opsi TLS/limit per baris
SMTP_REQUIRE_TLS=true
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_TLS_SERVERNAME=
SMTP_TLS_CA_PATH=
SMTP_MAX_CONNECTIONS=2
SMTP_RATE_LIMIT=10
SMTP_RATE_DELTA_MS=1000
SMTP_VERIFY_CONCURRENCY=3
SMTP_COOLDOWN_SECONDS=10
SMTP_CONNECTION_TIMEOUT_MS=30000
SMTP_GREETING_TIMEOUT_MS=30000
SMTP_SOCKET_TIMEOUT_MS=60000

# Hostname EHLO/HELO stabil, berbeda dari hostname sertifikat server
SMTP_HOSTNAME=localhost

# ============================================
# EMAIL CONTENT CONFIGURATION
# ============================================
# Nama pengirim (support placeholder dinamis)
SENDER_NAME=Nama Pengirim

# Subject email (support placeholder dinamis)
EMAIL_SUBJECT=Subject Email Anda

# Path ke template HTML (relatif dari root project)
LETTER_PATH=letters/letter.html
TEXT_LETTER_PATH=
EMAIL_LOCALE=id-ID
EMAIL_TIMEZONE=Asia/Jakarta
# Untuk template Ashland isi tanggal akhir promo dan endpoint unsubscribe asli
PROMO_END_DATE=
# ON menampilkan blok unsubscribe dan header bila URL tersedia; OFF menghapusnya
ENABLE_UNSUBSCRIBE=true
UNSUBSCRIBE_URL_TEMPLATE=

# Custom from email (opsional, jika kosong akan pakai SMTP_USER)
# Alamat valid yang diizinkan SMTP; CSV from_email dapat override per server
CUSTOM_FROM_EMAIL=
# Tujuan balasan (single/multiple). Kosong: balasan mengikuti From.
# CSV reply_to dapat override per server; gunakan mailbox yang benar-benar menerima balasan.
REPLY_TO=

# Prioritas email: high, normal, low
EMAIL_PRIORITY=normal

# Gunakan header minimal (true/false)
# Jika true, tidak akan menambah X-Priority dan X-NSS header
USE_MINIMAL_HEADERS=false

# ============================================
# SENDING MODE CONFIGURATION
# ============================================
# Mode batch: true = kirim paralel per batch, false = kirim satu per satu
ENABLE_BATCH_SENDING=false

# Jumlah email per batch (hanya berlaku jika ENABLE_BATCH_SENDING=true)
BATCH_SIZE=10
MAX_CONCURRENCY=5

# Delay dalam detik antar email/batch
SEND_DELAY_SECONDS=1

# ============================================
# LIST MANAGEMENT
# ============================================
# Hapus email duplikat dari list sebelum kirim (true/false)
REMOVE_DUPLICATE_EMAILS=true

# Hapus email yang sudah terkirim dari file list (true/false)
REMOVE_SENT_EMAIL_FROM_LIST=false
SUPPRESSION_LIST_PATH=lists/suppressed.txt

# ============================================
# DEBUG MODE
# ============================================
# Diagnostik status saja; raw SMTP traffic tidak dicetak
DEBUG_MODE=false

# ============================================
# RETRY CONFIGURATION
# ============================================
# Jumlah percobaan ulang jika pengiriman gagal (0 = tidak ada retry)
RETRY_ATTEMPTS=2

# Delay dalam detik sebelum retry
RETRY_DELAY_SECONDS=3

# ============================================
# FILE LOGGING
# ============================================
# Simpan hasil pengiriman ke file log di folder logs/ (true/false)
ENABLE_FILE_LOGGING=true
LOG_DIR=logs
# Journal selalu aktif, walaupun file logging dimatikan
JOURNAL_DIR=logs/campaigns
